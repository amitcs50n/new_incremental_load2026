{
	"name": "pl_pharma_sales_incremental",
	"properties": {
		"activities": [
			{
				"name": "GetActiveConfigs",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT source_table, target_folder, watermark_column, last_watermark, merge_type, primary_key_col\n       FROM pipeline_watermark_audit\n       WHERE is_active = 1",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_azsql_watermark",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEachTable",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "GetActiveConfigs",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('GetActiveConfigs').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "CopyMySQLToADLS",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "MySqlSource",
									"query": {
										"value": "SELECT * FROM @{item().source_table} WHERE @{item().watermark_column} > '@{item().last_watermark}'",
										"type": "Expression"
									}
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_mysql_generic",
									"type": "DatasetReference",
									"parameters": {
										"tableName": {
											"value": "@item().source_table",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_adls_generic",
									"type": "DatasetReference",
									"parameters": {
										"folderPath": {
											"value": "@concat(item().target_folder, '/year=', formatDateTime(utcnow(), 'yyyy'), '/month=', formatDateTime(utcnow(), 'MM'), '/day=', formatDateTime(utcnow(), 'dd'))",
											"type": "Expression"
										},
										"fileName": {
											"value": "@concat(item().source_table, '_', formatDateTime(utcnow(), 'yyyyMMddHHmmss'), '.parquet')",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "GetMaxFromCopiedData",
							"type": "Lookup",
							"dependsOn": [
								{
									"activity": "CopyMySQLToADLS",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "MySqlSource",
									"query": {
										"value": "SELECT MAX(@{item().watermark_column}) AS max_wm FROM @{item().source_table} WHERE @{item().watermark_column} > '@{item().last_watermark}'",
										"type": "Expression"
									}
								},
								"dataset": {
									"referenceName": "ds_mysql_generic",
									"type": "DatasetReference",
									"parameters": {
										"tableName": "@item().source_table"
									}
								}
							}
						},
						{
							"name": "IfRowsCopied",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "GetMaxFromCopiedData",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@greater(activity('CopyMySQLToADLS').output.rowsCopied, 0)",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "if_no_data",
										"type": "SetVariable",
										"dependsOn": [],
										"policy": {
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"variableName": "log_message",
											"value": "\"No new data for this run\""
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "StagePendingWatermark",
										"type": "Script",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"linkedServiceName": {
											"referenceName": "AzureSqlDatabase_linked_service",
											"type": "LinkedServiceReference"
										},
										"typeProperties": {
											"scripts": [
												{
													"type": "Query",
													"text": {
														"value": "INSERT INTO pipeline_watermark_pending (run_id, source_table, new_watermark)\nVALUES (\n    '@{pipeline().RunId}',\n    '@{item().source_table}',\n    '@{activity('GetMaxFromCopiedData').output.firstRow.max_watermark}'\n)",
														"type": "Expression"
													}
												}
											],
											"scriptBlockExecutionTimeout": "02:00:00"
										}
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "RunDatabricksMerges",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "ForEachTable",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Users/rinku@ispjooutlook.onmicrosoft.com/pharma_sales_pipeline"
				},
				"linkedServiceName": {
					"referenceName": "AzureDatabricks_linked_service",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "PromotePendingWatermarks",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "RunDatabricksMerges",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "AzureSqlDatabase_linked_service",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "\nUPDATE w\nSET w.last_watermark = p.new_watermark,\n    w.updated_at = GETDATE()\nFROM pipeline_watermark_audit w\nINNER JOIN pipeline_watermark_pending p\n    ON w.source_table = p.source_table\nWHERE p.run_id = '@{pipeline().RunId}';\n\n-- Clean up this run's pending rows after successful promotion\n\nDELETE FROM pipeline_watermark_pending\nWHERE run_id = '@{pipeline().RunId}';\n",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "on_databricks_failure",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "RunDatabricksMerges",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "AzureSqlDatabase_linked_service",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "DELETE FROM pipeline_watermark_pending WHERE run_id = '@{pipeline().RunId}';\n\n-- Clean up pending rows when this run failed",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"variables": {
			"log_message": {
				"type": "String"
			}
		},
		"annotations": []
	}
}