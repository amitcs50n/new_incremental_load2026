{
	"name": "pl_pharma_sales_incremental",
	"properties": {
		"activities": [
			{
				"name": "GetActiveConfigs",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT source_table, target_folder, watermark_column, last_watermark, merge_type, primary_key_col\n       FROM pipeline_watermark_audit\n       WHERE is_active = 1",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_azsql_watermark",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEachTable",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "GetActiveConfigs",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('GetActiveConfigs').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "GetUpperWatermarkBeforeCopy",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "MySqlSource",
									"query": {
										"value": "select MAX(@{item().watermark_column}) AS upper_watermark\nfrom @{item().source_table} WHERE @{item().watermark_column} > '@{item().last_watermark}'\n",
										"type": "Expression"
									}
								},
								"dataset": {
									"referenceName": "ds_mysql_generic",
									"type": "DatasetReference",
									"parameters": {
										"tableName": {
											"value": "@item().source_table",
											"type": "Expression"
										}
									}
								}
							}
						},
						{
							"name": "IfHasNewWatermark",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "GetUpperWatermarkBeforeCopy",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@not(equals(activity('GetUpperWatermarkBeforeCopy').output.firstRow.upper_watermark, null))",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "NoNewData",
										"type": "SetVariable",
										"dependsOn": [],
										"policy": {
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"variableName": "log_message",
											"value": "No New Data found"
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "CopyMySQLToADLS",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "MySqlSource",
												"query": {
													"value": "SELECT *\nFROM @{item().source_table}\nWHERE @{item().watermark_column} > '@{item().last_watermark}'\nand @{item().watermark_column} <= '@{activity('GetUpperWatermarkBeforeCopy').output.firstRow.upper_watermark}'",
													"type": "Expression"
												}
											},
											"sink": {
												"type": "ParquetSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												},
												"formatSettings": {
													"type": "ParquetWriteSettings"
												}
											},
											"enableStaging": false,
											"translator": {
												"type": "TabularTranslator",
												"typeConversion": true,
												"typeConversionSettings": {
													"allowDataTruncation": true,
													"treatBooleanAsNumber": false
												}
											}
										},
										"inputs": [
											{
												"referenceName": "ds_mysql_generic",
												"type": "DatasetReference",
												"parameters": {
													"tableName": {
														"value": "@item().source_table",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "ds_adls_generic",
												"type": "DatasetReference",
												"parameters": {
													"folderPath": {
														"value": "@concat(item().target_folder, '/year=', formatDateTime(utcnow(),\n 'yyyy'), '/month=', formatDateTime(utcnow(), 'MM'), '/day=',\n formatDateTime(utcnow(), 'dd'))",
														"type": "Expression"
													},
													"fileName": {
														"value": "@concat(item().source_table, '_', formatDateTime(utcNow(),\n'yyyyMMddHHmmss'), '.parquet')",
														"type": "Expression"
													}
												}
											}
										]
									},
									{
										"name": "StagePendingWatermark",
										"type": "Script",
										"dependsOn": [
											{
												"activity": "MarkHasNewData",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"linkedServiceName": {
											"referenceName": "AzureSqlDatabase_linked_service",
											"type": "LinkedServiceReference"
										},
										"typeProperties": {
											"scripts": [
												{
													"type": "Query",
													"text": {
														"value": "INSERT INTO pipeline_watermark_pending (run_id, source_table, new_watermark)\nVALUES (\n    '@{pipeline().RunId}',\n    '@{item().source_table}',\n    '@{activity('GetUpperWatermarkBeforeCopy').output.firstRow.upper_watermark}'\n)",
														"type": "Expression"
													}
												}
											],
											"scriptBlockExecutionTimeout": "02:00:00"
										}
									},
									{
										"name": "MarkHasNewData",
										"type": "SetVariable",
										"dependsOn": [
											{
												"activity": "CopyMySQLToADLS",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"variableName": "has_new_data",
											"value": "\"false\""
										}
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "IfAnyDataCopied",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "ForEachTable",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@\"equals(variables('has_new_data'), 'true')\"\n",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "when_no_data_copy",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "log_message",
								"value": "No new data in any table; skipped Databricks"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "RunDatabricksMerges_copy1",
							"type": "DatabricksNotebook",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"notebookPath": "/Users/rinku@ispjooutlook.onmicrosoft.com/new_incremental_load2026/databricks/pharma_sales_pipeline",
								"baseParameters": {
									"run_id": {
										"value": "@pipeline().RunId",
										"type": "Expression"
									},
									"pipeline_name": {
										"value": "@pipeline().Pipeline",
										"type": "Expression"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "AzureDatabricks_linked_service",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "PromotePendingWatermarks_copy1",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "RunDatabricksMerges_copy1",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "AzureSqlDatabase_linked_service",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "UPDATE w\nSET w.last_watermark = p.new_watermark,\n    w.updated_at = GETDATE()\nFROM pipeline_watermark_audit w\nINNER JOIN pipeline_watermark_pending p\n    ON w.source_table = p.source_table\nWHERE p.run_id = '@{pipeline().RunId}';\n\n-- Clean up this run's pending rows after successful promotion\n\nDELETE FROM pipeline_watermark_pending\nWHERE run_id = '@{pipeline().RunId}';\n",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "on_databricks_failure_copy1",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "RunDatabricksMerges_copy1",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "AzureSqlDatabase_linked_service",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "DELETE FROM pipeline_watermark_pending WHERE run_id = '@{pipeline().RunId}';\n\n-- Clean up pending rows when this run failed",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			}
		],
		"variables": {
			"log_message": {
				"type": "String"
			},
			"has_new_data": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-05-14T12:55:25Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}